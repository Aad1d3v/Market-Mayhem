[TEMPLATE]
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY — never used in production.
#
# On Render, ALL runtime values are injected by the platform:
#   • DATABASE_URL  → wired from the managed Postgres (render.yaml / dashboard)
#   • PORT          → injected by Render into the container
#   • CLIENT_URL    → derived from RENDER_EXTERNAL_URL at runtime
#   • SESSION_SECRET / ADMIN_PASSWORD → generated by render.yaml
# No ports, URLs, or connection strings are hardcoded in the codebase.
# ------------------------------------------------------------------------------

# Database (Docker Compose Postgres — see docker-compose.yml)
# For a managed provider (Neon, Supabase, RDS...) replace with its connection string.
DATABASE_URL="postgresql://aadiinvest:aadiinvest_dev_pw@localhost:5432/aadiinvest?schema=public"

# Session signing secret — generate with: openssl rand -base64 48
SESSION_SECRET="change-me-please-generate-a-long-random-string"

# Server (PORT is injected by Render in production; this is local dev only)
PORT=4000
NODE_ENV=development

# Where the client runs (used for CORS + links in emails).
# In production this is derived from RENDER_EXTERNAL_URL — leave unset.
CLIENT_URL="http://localhost:5173"

# Market data
# AadiInvest ships with a deterministic SIMULATED price engine (50-day repeating
# pattern). To plug in a real provider later, implement a new adapter in
# server/src/services/market-data/ and set:
# MARKET_DATA_PROVIDER=finnhub
# MARKET_DATA_API_KEY=your-key
MARKET_DATA_PROVIDER="simulated"
MARKET_DATA_API_KEY=""

# Google OAuth (optional — sign-in button auto-hides when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (optional in development — verification/reset codes are printed to the
# server console when no SMTP transport is configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="AadiInvest <no-reply@aadiinvest.example>"

# Bootstrap admin account (created by `npm run db:seed`).
# In production ADMIN_PASSWORD is REQUIRED — the seed refuses to run without it.
ADMIN_EMAIL="admin@aadiinvest.local"
ADMIN_PASSWORD="ChangeMe!Admin2026"
